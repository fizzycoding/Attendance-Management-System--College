      <string notr="true">#backgroundFrame {
    background-color: white;
}
QLabel {
    color: #333;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    font-weight: 600;
    border: none; 
}
#label_class_name {
    color: #3388FF;
    font-size: 16px;
    font-weight: 700;
}

/* Checkbox Style */
QCheckBox {
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    color: #333;
    spacing: 8px;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 1px solid #999;
    border-radius: 4px;
    background: white;
}
QCheckBox::indicator:checked {
    background-color: #3388FF;
    border: 1px solid #3388FF;
    image: url(icons/checked.png); /* Ensure you handle the icon or remove this line if strictly relying on color */
}

/* General Input Style */
QDateEdit {
    height: 35px;
    padding: 0 10px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    color: #111;
    border: 1px solid rgb(150, 150, 150);
    background: #fff;
    border-radius: 4px;
}
QDateEdit:focus {
    border: 1.5px solid #3388FF;
}
QCalendarWidget QWidget { background-color: white; color: black; }
QCalendarWidget QAbstractItemView:enabled { 
    color: black; 
    selection-background-color: #3388FF; 
    selection-color: white;
}
QCalendarWidget QToolButton { color: black; icon-size: 25px; }
QCalendarWidget QSpinBox { background-color: white; color: black; }

QPushButton {
    height: 40px;
    padding: 0 16px;
    border: none;
    border-radius: 5px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 14px;
    font-weight: 700;
    color: white;
}

#btn_excel {
    background-color: #3388FF;
}
#btn_excel:hover { background-color: #0055FF; }

#btn_close {
    background-color: transparent;
    color: #555;
    border: 1px solid #ccc;
}
#btn_close:hover { background-color: #f0f0f0; }
</string>
