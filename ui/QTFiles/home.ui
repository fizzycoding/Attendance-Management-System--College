/* Base style for all sidebar buttons */
QPushButton {
    background-color: transparent;
    color: white;
    text-align: left;
    padding-left: 20px;
    border: none;
    font-size: 14px;
    font-weight: 500;
    height: 45px;
    border-left: 5px solid transparent;
	qproperty-cursor: PointingHandCursor;
}

QPushButton:hover {
    background-color: #159079;
}

QPushButton:checked {
    background-color: #159079;
    border-left: 5px solid #ffffff;
    font-weight: bold;
}</string>
